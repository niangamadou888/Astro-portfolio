# Copy to .env for local development (`npx netlify dev`).
# In production these live in Netlify → Site configuration → Environment variables.
# .env is gitignored — never commit real keys.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=amadouniang2001@gmail.com

# Sender address. The domain must be verified at https://resend.com/domains,
# otherwise Resend rejects the send with a 403.
CONTACT_FROM_EMAIL="Portfolio <contact@amadouniang.dev>"
